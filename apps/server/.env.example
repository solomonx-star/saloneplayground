# Copy to apps/server/.env and fill in. That file is ignored by Git: never commit a real connection string.

# MongoDB connection string (for example from MongoDB Atlas, or mongodb://127.0.0.1:27017 for a local server).
MONGODB_URI=

# The database to use inside that cluster. Keep development and live games apart.
MONGODB_DB=salone_dev

# Port the game server listens on (hosts such as Railway set this themselves).
PORT=4000

# The web app's address(es) allowed to connect, comma-separated, e.g. https://play.example.com. Leave empty while
# developing to allow any (including phones on the local network); always set it on a public server.
WEB_ORIGIN=

# How long a room is kept after its last change, and how long computer players pause before moving.
ROOM_HOURS=12
CPU_DELAY_MS=700

# How long to wait for a player who is away (disconnected) on their turn before playing for them (Ludo).
AWAY_SECONDS=30
