{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
