{
  "name": "salone-playground",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @salone/web",
    "build": "npm run build -w @salone/web",
    "start": "npm run start -w @salone/web",
    "lint": "eslint",
    "typecheck": "npm run typegen -w @salone/web && tsc -p apps/web --noEmit && tsc -p packages/games --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
